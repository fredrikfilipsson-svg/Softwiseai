<%- include('partials/header') %>
<%- include('partials/sidebar') %>
    <main class="main-content">
      <div class="page-header">
        <h1>Compose Newsletter</h1>
        <p class="page-desc">Create and send your newsletter</p>
      </div>

      <div class="compose-wrapper">
        <div class="compose-meta">
          <div class="form-group">
            <label for="subject">Subject Line *</label>
            <input type="text" id="subject" class="form-control" placeholder="e.g., Oracle Licensing Update — Q1 2025" required>
          </div>
          <div class="form-group">
            <label for="previewText">Preview Text</label>
            <input type="text" id="previewText" class="form-control" placeholder="Brief text shown in inbox previews...">
          </div>
        </div>

        <div class="compose-tabs">
          <button class="tab-btn active" data-tab="editor">Write in Browser</button>
          <button class="tab-btn" data-tab="paste">Paste HTML</button>
          <button class="tab-btn" data-tab="upload">Upload HTML File</button>
        </div>

        <div class="tab-content active" id="tab-editor">
          <div id="quill-editor" class="quill-container"></div>
        </div>

        <div class="tab-content" id="tab-paste">
          <div class="paste-layout">
            <div class="paste-code">
              <label>HTML Code</label>
              <textarea id="htmlPaste" class="code-textarea" placeholder="Paste your HTML here..."></textarea>
            </div>
            <div class="paste-preview">
              <label>Preview</label>
              <iframe id="pastePreview" class="preview-frame"></iframe>
            </div>
          </div>
        </div>

        <div class="tab-content" id="tab-upload">
          <form id="uploadForm" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="upload-zone" id="dropZone">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <p>Drag & drop an HTML file here, or <label for="htmlFile" class="upload-link">browse</label></p>
              <input type="file" id="htmlFile" name="htmlFile" accept=".html" style="display:none">
              <span class="upload-hint">Only .html files up to 5MB</span>
            </div>
          </form>
          <div id="uploadPreviewWrap" style="display:none; margin-top: 1rem;">
            <label>Uploaded Content Preview</label>
            <iframe id="uploadPreview" class="preview-frame"></iframe>
          </div>
        </div>

        <div class="compose-actions">
          <button class="btn btn-secondary" id="btnPreview">Preview Email</button>
          <button class="btn btn-secondary" id="btnTestSend">Send Test Email</button>
          <button class="btn btn-primary" id="btnSendAll">Send to All Subscribers</button>
        </div>

        <div id="sendStatus" class="send-status" style="display:none;">
          <div class="send-progress">
            <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
            <span id="sendStatusText">Preparing to send...</span>
          </div>
        </div>
      </div>

      <!-- Preview Modal -->
      <div class="modal" id="previewModal">
        <div class="modal-overlay"></div>
        <div class="modal-content modal-lg">
          <div class="modal-header">
            <h3>Email Preview</h3>
            <button class="modal-close" onclick="closeModal('previewModal')">&times;</button>
          </div>
          <div class="modal-body">
            <iframe id="fullPreview" class="preview-frame-lg"></iframe>
          </div>
        </div>
      </div>

      <!-- Confirm Send Modal -->
      <div class="modal" id="confirmSendModal">
        <div class="modal-overlay"></div>
        <div class="modal-content">
          <div class="modal-header">
            <h3>Confirm Send</h3>
            <button class="modal-close" onclick="closeModal('confirmSendModal')">&times;</button>
          </div>
          <div class="modal-body">
            <p>You are about to send this newsletter to <strong id="recipientCount">0</strong> active subscribers.</p>
            <p>Subject: <strong id="confirmSubject"></strong></p>
            <p>This action cannot be undone. Proceed?</p>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('confirmSendModal')">Cancel</button>
            <button class="btn btn-primary" id="btnConfirmSend">Send Now</button>
          </div>
        </div>
      </div>

      <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
      <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Initialize Quill editor
          var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Write your newsletter content here...',
            modules: {
              toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['blockquote'],
                ['link', 'image'],
                [{ 'align': [] }],
                ['clean']
              ]
            }
          });

          // Tab switching
          document.querySelectorAll('.tab-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
              document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
              btn.classList.add('active');
              document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
            });
          });

          // Live preview for paste HTML
          var htmlPaste = document.getElementById('htmlPaste');
          var pastePreview = document.getElementById('pastePreview');
          htmlPaste.addEventListener('input', function() {
            var doc = pastePreview.contentDocument || pastePreview.contentWindow.document;
            doc.open();
            doc.write(htmlPaste.value);
            doc.close();
          });

          // File upload
          var htmlFileInput = document.getElementById('htmlFile');
          var dropZone = document.getElementById('dropZone');
          var uploadedHtml = '';

          dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
          dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('dragover'); });
          dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
              handleFile(e.dataTransfer.files[0]);
            }
          });

          htmlFileInput.addEventListener('change', function() {
            if (htmlFileInput.files.length) {
              handleFile(htmlFileInput.files[0]);
            }
          });

          function handleFile(file) {
            if (!file.name.endsWith('.html')) {
              showToast('Please upload an HTML file.', 'error');
              return;
            }
            var reader = new FileReader();
            reader.onload = function(e) {
              uploadedHtml = e.target.result;
              document.getElementById('uploadPreviewWrap').style.display = 'block';
              var frame = document.getElementById('uploadPreview');
              var doc = frame.contentDocument || frame.contentWindow.document;
              doc.open();
              doc.write(uploadedHtml);
              doc.close();
              dropZone.innerHTML = '<p style="color:#28a745;">File loaded: ' + file.name + '</p>';
            };
            reader.readAsText(file);
          }

          function getHtmlContent() {
            var activeTab = document.querySelector('.tab-btn.active').dataset.tab;
            if (activeTab === 'editor') {
              return quill.root.innerHTML;
            } else if (activeTab === 'paste') {
              return htmlPaste.value;
            } else if (activeTab === 'upload') {
              return uploadedHtml;
            }
            return '';
          }

          // Preview
          document.getElementById('btnPreview').addEventListener('click', function() {
            var html = getHtmlContent();
            if (!html || html === '<p><br></p>') {
              showToast('Please add some content first.', 'error');
              return;
            }
            var frame = document.getElementById('fullPreview');
            var doc = frame.contentDocument || frame.contentWindow.document;
            doc.open();
            doc.write(html);
            doc.close();
            openModal('previewModal');
          });

          // Save and get newsletter ID
          function saveNewsletter(callback) {
            var subject = document.getElementById('subject').value.trim();
            var previewText = document.getElementById('previewText').value.trim();
            var htmlContent = getHtmlContent();

            if (!subject) { showToast('Subject line is required.', 'error'); return; }
            if (!htmlContent || htmlContent === '<p><br></p>') { showToast('Newsletter content is required.', 'error'); return; }

            fetch('/admin/compose/save', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ subject: subject, previewText: previewText, htmlContent: htmlContent, _csrf: '<%= csrfToken %>' })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.success) {
                callback(data.newsletter);
              } else {
                showToast(data.error || 'Save failed.', 'error');
              }
            })
            .catch(function() { showToast('Network error.', 'error'); });
          }

          // Test send
          document.getElementById('btnTestSend').addEventListener('click', function() {
            saveNewsletter(function(newsletter) {
              fetch('/admin/send-test/' + newsletter.id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
              })
              .then(function(r) { return r.json(); })
              .then(function(data) {
                if (data.success) {
                  showToast(data.message, 'success');
                } else {
                  showToast(data.error || 'Test send failed.', 'error');
                }
              })
              .catch(function() { showToast('Network error.', 'error'); });
            });
          });

          // Send to all
          document.getElementById('btnSendAll').addEventListener('click', function() {
            var subject = document.getElementById('subject').value.trim();
            if (!subject) { showToast('Subject line is required.', 'error'); return; }
            document.getElementById('confirmSubject').textContent = subject;

            fetch('/admin/subscribers?_count=true')
              .catch(function() {});

            // Just show the modal with what we know
            document.getElementById('recipientCount').textContent = '...';
            openModal('confirmSendModal');

            // Fetch actual count
            saveNewsletter(function(newsletter) {
              window._pendingNewsletter = newsletter;
              // The count will be returned on send
              document.getElementById('recipientCount').textContent = 'all';
            });
          });

          document.getElementById('btnConfirmSend').addEventListener('click', function() {
            closeModal('confirmSendModal');
            if (!window._pendingNewsletter) {
              showToast('Please wait for save to complete.', 'error');
              return;
            }

            var statusEl = document.getElementById('sendStatus');
            statusEl.style.display = 'block';
            document.getElementById('sendStatusText').textContent = 'Starting send...';
            document.getElementById('progressFill').style.width = '10%';

            fetch('/admin/send/' + window._pendingNewsletter.id, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.success) {
                document.getElementById('sendStatusText').textContent = 'Sending to ' + data.totalRecipients + ' subscribers...';
                pollSendStatus(window._pendingNewsletter.id, data.totalRecipients);
              } else {
                document.getElementById('sendStatusText').textContent = 'Error: ' + (data.error || 'Send failed');
                document.getElementById('progressFill').style.width = '100%';
                document.getElementById('progressFill').style.background = '#dc3545';
              }
            })
            .catch(function() {
              document.getElementById('sendStatusText').textContent = 'Network error.';
            });
          });

          function pollSendStatus(newsletterId, total) {
            var interval = setInterval(function() {
              fetch('/admin/newsletter-status/' + newsletterId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  var done = data.successfulSends + data.failedSends;
                  var pct = total > 0 ? Math.round((done / total) * 100) : 0;
                  document.getElementById('progressFill').style.width = pct + '%';
                  document.getElementById('sendStatusText').textContent =
                    'Sent: ' + data.successfulSends + ' | Failed: ' + data.failedSends + ' | Total: ' + total;

                  if (data.status === 'sent' || data.status === 'failed' || done >= total) {
                    clearInterval(interval);
                    document.getElementById('progressFill').style.width = '100%';
                    if (data.status === 'failed') {
                      document.getElementById('progressFill').style.background = '#dc3545';
                    } else {
                      document.getElementById('progressFill').style.background = '#28a745';
                    }
                    document.getElementById('sendStatusText').textContent =
                      'Complete! Sent: ' + data.successfulSends + ' | Failed: ' + data.failedSends;
                  }
                });
            }, 2000);
          }
        });
      </script>
    </main>
<%- include('partials/footer') %>
