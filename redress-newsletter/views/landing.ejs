<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enterprise Software Licensing Insights | Redress Compliance</title>
  <meta name="description" content="Subscribe to expert analysis on Oracle, Microsoft, SAP, and multi-vendor licensing strategies from Redress Compliance.">
  <meta name="keywords" content="enterprise software licensing, Oracle licensing, Microsoft licensing, SAP licensing, compliance, cost optimization">
  <meta property="og:title" content="Enterprise Software Licensing Insights">
  <meta property="og:description" content="Join industry leaders who receive expert licensing analysis from Redress Compliance.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8f9fa;
      color: #1a1a2e;
      line-height: 1.6;
    }
    .landing-header {
      background: #002B5C;
      padding: 1.5rem 2rem;
      text-align: center;
    }
    .landing-header .brand {
      color: #fff;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    .landing-header .brand-line {
      width: 60px;
      height: 2px;
      background: #B8860B;
      margin: 0.5rem auto 0;
    }
    .hero {
      background: linear-gradient(135deg, #002B5C 0%, #003d7a 100%);
      color: #fff;
      padding: 4rem 2rem;
      text-align: center;
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      line-height: 1.2;
    }
    .hero p {
      font-size: 1.15rem;
      color: rgba(255,255,255,0.85);
      max-width: 640px;
      margin: 0 auto 2.5rem;
    }
    .signup-card {
      background: #fff;
      border-radius: 12px;
      padding: 2.5rem;
      max-width: 480px;
      margin: -3rem auto 0;
      position: relative;
      z-index: 1;
      box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }
    .signup-card h2 {
      font-size: 1.3rem;
      margin-bottom: 1.5rem;
      color: #002B5C;
    }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.35rem; color: #555; }
    .form-group input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }
    .form-group input:focus { outline: none; border-color: #B8860B; box-shadow: 0 0 0 3px rgba(184,134,11,0.1); }
    .btn-subscribe {
      width: 100%;
      padding: 0.85rem;
      background: #B8860B;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      font-family: inherit;
    }
    .btn-subscribe:hover { background: #9a7209; }
    .btn-subscribe:disabled { opacity: 0.7; cursor: not-allowed; }
    .trust { text-align: center; margin-top: 1rem; font-size: 0.8rem; color: #888; }
    .msg { padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem; display: none; }
    .msg-success { background: #d4edda; color: #155724; display: block; }
    .msg-error { background: #f8d7da; color: #721c24; display: block; }
    .hp-field { position: absolute; left: -9999px; }
    .benefits {
      max-width: 640px;
      margin: 3rem auto;
      padding: 0 2rem;
    }
    .benefits h3 {
      font-size: 1.25rem;
      color: #002B5C;
      margin-bottom: 1.25rem;
      text-align: center;
    }
    .benefits ul {
      list-style: none;
      padding: 0;
    }
    .benefits li {
      padding: 0.75rem 0;
      padding-left: 2rem;
      position: relative;
      border-bottom: 1px solid #eee;
      font-size: 0.95rem;
      color: #444;
    }
    .benefits li:last-child { border-bottom: none; }
    .benefits li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1rem;
      width: 10px;
      height: 10px;
      background: #B8860B;
      border-radius: 50%;
    }
    .landing-footer {
      text-align: center;
      padding: 2rem;
      color: #888;
      font-size: 0.8rem;
      border-top: 1px solid #eee;
      margin-top: 3rem;
    }
    .landing-footer a { color: #B8860B; text-decoration: none; }
    @media (max-width: 600px) {
      .hero h1 { font-size: 1.75rem; }
      .hero p { font-size: 1rem; }
      .hero { padding: 3rem 1.5rem; }
      .signup-card { margin: -2rem 1rem 0; padding: 1.5rem; }
    }
  </style>
</head>
<body>
  <header class="landing-header">
    <div class="brand">REDRESS COMPLIANCE</div>
    <div class="brand-line"></div>
  </header>

  <section class="hero">
    <h1>Enterprise Software Licensing Insights</h1>
    <p>Join industry leaders who receive our expert analysis on Oracle, Microsoft, SAP, and multi-vendor licensing strategies.</p>
  </section>

  <div class="signup-card">
    <h2>Subscribe to Our Newsletter</h2>
    <div class="msg" id="formMsg"></div>
    <form id="subscribeForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp-field">
        <label for="_hp_field">Leave this empty</label>
        <input type="text" name="_hp_field" id="_hp_field" tabindex="-1" autocomplete="off">
      </div>
      <div class="form-group">
        <label for="email">Email Address *</label>
        <input type="email" id="email" name="email" required placeholder="you@company.com">
      </div>
      <div class="form-group">
        <label for="name">First Name (optional)</label>
        <input type="text" id="name" name="name" placeholder="Your first name">
      </div>
      <button type="submit" class="btn-subscribe" id="submitBtn">Subscribe</button>
      <p class="trust">No spam. Unsubscribe anytime. We respect your privacy.</p>
    </form>
  </div>

  <section class="benefits">
    <h3>What You'll Receive</h3>
    <ul>
      <li><strong>Licensing Intelligence</strong> — Deep analysis of licensing changes from Oracle, Microsoft, SAP, and other major vendors</li>
      <li><strong>Cost Optimization Strategies</strong> — Practical insights to reduce enterprise software spend without sacrificing compliance</li>
      <li><strong>Vendor Negotiation Tips</strong> — Proven approaches for better licensing terms and contract outcomes</li>
      <li><strong>Compliance Updates</strong> — Stay ahead of audit risks and regulatory changes affecting your software estate</li>
    </ul>
  </section>

  <footer class="landing-footer">
    <p>Redress Compliance LLC | Independent Enterprise Software Licensing Advisory</p>
    <p>1314 E Las Olas Blvd, Fort Lauderdale, FL 33301</p>
    <p style="margin-top: 0.5rem;"><a href="https://redresscompliance.com">redresscompliance.com</a></p>
  </footer>

  <script>
    document.getElementById('subscribeForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('submitBtn');
      var msg = document.getElementById('formMsg');
      var email = document.getElementById('email').value;
      var name = document.getElementById('name').value;
      var hp = document.getElementById('_hp_field').value;

      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      msg.className = 'msg';
      msg.style.display = 'none';

      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, name: name, source: 'landing-page', _hp_field: hp })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) {
          msg.className = 'msg msg-error';
          msg.textContent = data.error;
          msg.style.display = 'block';
        } else {
          msg.className = 'msg msg-success';
          msg.textContent = data.message || 'Thank you! Please check your email to confirm.';
          msg.style.display = 'block';
          document.getElementById('subscribeForm').reset();
        }
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      })
      .catch(function() {
        msg.className = 'msg msg-error';
        msg.textContent = 'Something went wrong. Please try again.';
        msg.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      });
    });
  </script>
</body>
</html>
