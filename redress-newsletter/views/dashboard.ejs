<%- include('partials/header') %>
<%- include('partials/sidebar') %>
    <main class="main-content">
      <div class="page-header">
        <h1>Dashboard</h1>
        <p class="page-desc">Newsletter overview and key metrics</p>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(0,43,92,0.1); color: #002B5C;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.total %></span>
            <span class="stat-label">Total Subscribers</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(40,167,69,0.1); color: #28a745;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.active %></span>
            <span class="stat-label">Active Subscribers</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.unsubscribed %></span>
            <span class="stat-label">Unsubscribed</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(184,134,11,0.1); color: #B8860B;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.newslettersSent %></span>
            <span class="stat-label">Newsletters Sent</span>
          </div>
        </div>
      </div>

      <div class="quick-actions">
        <h2>Quick Actions</h2>
        <div class="actions-grid">
          <a href="/admin/compose" class="action-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Compose Newsletter</span>
          </a>
          <a href="/admin/subscribers" class="action-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            <span>Add Subscriber</span>
          </a>
          <a href="/admin/history" class="action-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>View History</span>
          </a>
        </div>
      </div>
    </main>
<%- include('partials/footer') %>
