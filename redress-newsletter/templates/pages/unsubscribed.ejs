<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unsubscribed | Redress Compliance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8f9fa;
      color: #1a1a2e;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .page-header {
      background: #002B5C;
      padding: 1.5rem 2rem;
      text-align: center;
    }
    .page-header .brand { color: #fff; font-size: 1rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; }
    .page-header .brand-line { width: 60px; height: 2px; background: #B8860B; margin: 0.5rem auto 0; }
    .content {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 3rem;
      max-width: 480px;
      width: 100%;
      text-align: center;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }
    .card h1 { font-size: 1.5rem; color: #002B5C; margin-bottom: 1rem; }
    .card p { color: #666; line-height: 1.6; margin-bottom: 1.5rem; }
    .btn {
      display: inline-block;
      padding: 0.75rem 2rem;
      background: #B8860B;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: background 0.2s;
      border: none;
      cursor: pointer;
      font-family: inherit;
    }
    .btn:hover { background: #9a7209; }
    .btn-outline {
      background: transparent;
      color: #002B5C;
      border: 2px solid #002B5C;
      margin-left: 0.5rem;
    }
    .btn-outline:hover { background: #002B5C; color: #fff; }
    .msg { padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem; display: none; }
    .msg-success { background: #d4edda; color: #155724; display: block; }
    .msg-error { background: #f8d7da; color: #721c24; display: block; }
    .page-footer {
      text-align: center;
      padding: 1.5rem;
      font-size: 0.8rem;
      color: #999;
      border-top: 1px solid #eee;
    }
  </style>
</head>
<body>
  <header class="page-header">
    <div class="brand">REDRESS COMPLIANCE</div>
    <div class="brand-line"></div>
  </header>
  <div class="content">
    <div class="card">
      <h1><%= title %></h1>
      <p><%= message %></p>
      <div class="msg" id="resubMsg"></div>
      <% if (email) { %>
        <button class="btn" id="resubBtn" onclick="resubscribe()">Re-subscribe</button>
      <% } %>
      <a href="https://redresscompliance.com" class="btn btn-outline">Visit Website</a>
    </div>
  </div>
  <footer class="page-footer">
    <p>Redress Compliance LLC | Independent Enterprise Software Licensing Advisory</p>
    <p>1314 E Las Olas Blvd, Fort Lauderdale, FL 33301</p>
  </footer>

  <% if (email) { %>
  <script>
    function resubscribe() {
      var btn = document.getElementById('resubBtn');
      var msg = document.getElementById('resubMsg');
      btn.disabled = true;
      btn.textContent = 'Processing...';

      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: '<%= email %>', source: 'widget' })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) {
          msg.className = 'msg msg-error';
          msg.textContent = data.error;
        } else {
          msg.className = 'msg msg-success';
          msg.textContent = data.message || 'Please check your email to confirm.';
          btn.style.display = 'none';
        }
      })
      .catch(function() {
        msg.className = 'msg msg-error';
        msg.textContent = 'Something went wrong. Please try again.';
        btn.disabled = false;
        btn.textContent = 'Re-subscribe';
      });
    }
  </script>
  <% } %>
</body>
</html>
